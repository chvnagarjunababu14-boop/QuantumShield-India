# ==============================================================================
# QuantumShield India — Backend Service Configuration
# ==============================================================================

# Comma-separated list of browser origins permitted by CORS.
# Wildcards ('*') are strictly disallowed for security.
#
# Development (Local Vite dev server):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production Example:
# Set to the exact scheme + domain(s) of your deployed frontend.
# CORS_ORIGINS=https://quantumshield.in,https://www.quantumshield.in

