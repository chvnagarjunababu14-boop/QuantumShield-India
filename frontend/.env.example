# Base URL of the QuantumShield India API. No trailing path.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Public InsForge Backend-as-a-Service Configuration
# Replace with your InsForge project URL and public anonymous key.
# Never place administrative API keys or database passwords in frontend code.
VITE_INSFORGE_BASE_URL=https://your-project.insforge.app
VITE_INSFORGE_ANON_KEY=your-public-anon-key

