# ==============================================================================
# QuantumShield India — Frontend Client Configuration
# ==============================================================================

# Backend API Base URL (no trailing slash).
# - Development: http://127.0.0.1:8000
# - Production: https://api.quantumshield.in (or leave blank for same-origin / reverse proxy)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Public InsForge Backend-as-a-Service (BaaS) Configuration
# Replace with your InsForge project URL and public anonymous key.
#
# CRITICAL SECURITY RULE:
# NEVER place InsForge administrative API keys (starting with 'ik_...') or
# database connection passwords in client-side environment files or browser builds!
# Only the public anonymous key (starting with 'anon_...') belongs here.
VITE_INSFORGE_BASE_URL=https://your-project.insforge.app
VITE_INSFORGE_ANON_KEY=your-public-anon-key


